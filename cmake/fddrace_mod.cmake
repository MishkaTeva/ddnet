function(apply_fddrace_mod target)
  if(NOT FDDRACE_MOD)
    return()
  endif()
  target_compile_definitions(${target} PRIVATE CONF_FDDRACE_MOD)
  target_sources(${target} PRIVATE ${FDDRACE_MOD_SRC})
endfunction()
